[Unit]
Description=Calendar kiosk sync server (Google Calendar -> http://127.0.0.1:8080)
After=network.target

[Service]
User=kiosk
Group=kiosk
WorkingDirectory=/opt/caldisplay
ExecStart=/usr/bin/python3 /opt/caldisplay/calsync.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
