[Unit]
Description=Calendar kiosk browser (cage + Chromium on tty1)
After=systemd-user-sessions.service plymouth-quit-wait.service caldisplay.service
Wants=caldisplay.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/opt/caldisplay/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
